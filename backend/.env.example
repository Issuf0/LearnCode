# Copiar para .env e preencher com os valores reais

# MySQL — criar a base de dados antes: CREATE DATABASE learncode CHARACTER SET utf8mb4;
DATABASE_URL=mysql+pymysql://learncode:senha_segura@localhost:3306/learncode?charset=utf8mb4

# Segurança — gerar com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=trocar_por_chave_secreta_de_64_caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Conta de administrador inicial (criada pelo script de seed)
ADMIN_NAME=Issufo Karimo
ADMIN_EMAIL=learncode.mz@gmail.com
ADMIN_PASSWORD=trocar_esta_senha

# Origens autorizadas do frontend (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000
