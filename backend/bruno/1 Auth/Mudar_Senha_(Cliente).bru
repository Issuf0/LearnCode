meta {
  name: Mudar Senha (Cliente)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/change-password
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{clientToken}}
}

body:json {
  {
    "current_password": "cliente123",
    "new_password": "novaSenha123"
  }
}

docs {
  O cliente troca a senha temporária. Devolve 204 sem corpo.
}
