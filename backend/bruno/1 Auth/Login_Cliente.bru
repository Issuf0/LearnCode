meta {
  name: Login Cliente
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "joao.teste@enterprisemz.co.mz",
    "password": "cliente123"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("clientToken", res.body.access_token);
  }
}

docs {
  Autentica um cliente. O token é guardado automaticamente em clientToken.
}
